# Copy to .env and change the passwords before use:  cp sample.env .env

# --- MySQL -------------------------------------------------------------
MYSQL_DATABASE=signage
MYSQL_USER=signage
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# --- App ---------------------------------------------------------------
# Set to true when serving over HTTPS so the login cookie is marked Secure
COOKIE_SECURE=false

# --- Host ports (change if they clash with other projects) -------------
APP_PORT=3001
MYSQL_HOST_PORT=3308
